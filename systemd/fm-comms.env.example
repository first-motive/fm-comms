# fm-comms.env — this host's real endpoints.
#
# The installer copies this file to /etc/fm-comms.env and you fill it in there.
# /etc/fm-comms.env is NEVER committed: the configs under zenoh/ carry ${...}
# placeholders and the installer renders them against this file. A real hostname
# or tailnet address in a tracked file is a bug.
#
# Both units read this file as their EnvironmentFile, so a change here plus a
# `systemctl restart fm-zenohd` (or fm-zenoh-bridge) is the whole update path.

# --- router (the office workstation) ----------------------------------------

# Port zenohd listens on. 7447 is the Zenoh convention; keep it unless it clashes.
FM_ROUTER_PORT=7447

# --- bridge (every rig) ------------------------------------------------------

# Where this rig finds the router. Use the workstation's TAILNET address, not its
# LAN address — a rig that leaves the office keeps working, and a contractor's
# machine resolves the same name.
#   tcp/<workstation>.<tailnet>.ts.net:7447
FM_ROUTER_ENDPOINT=tcp/CHANGEME:7447

# This rig's name. Becomes the topic prefix, so the desktop sees /<name>/head/...
# Lowercase, digits, dashes. Must be unique across the fleet.
FM_RIG_NAMESPACE=CHANGEME

# The DDS domain the rig's ROS nodes run on. The installer keeps the two lines
# below equal — the bridge unit exports ROS_DOMAIN_ID from here, and the rendered
# config takes the domain from FM_ROS_DOMAIN_ID, so they cannot drift apart.
FM_ROS_DOMAIN_ID=0
ROS_DOMAIN_ID=0

# Which bridge config this rig uses: recorder | processor | robot. Selects
# zenoh/bridge-<profile>.json5.
FM_BRIDGE_PROFILE=recorder

# --- episode queryable (processor rigs only) ---------------------------------

# Recorder output directory holding sessions.jsonl and the bag directories. The
# queryable reads it and never writes; the rsync pipeline owns what lands here.
FM_EPISODES_DIR=/home/CHANGEME/recordings

# Largest MCAP the queryable will return in one reply (bytes; 512 MiB default). A
# query is one request and one reply, so the whole file lands in memory on both
# ends — past this it refuses and tells the caller to rsync the bag instead.
FM_EPISODES_MAX_BYTES=536870912
