/// zenoh-bridge-ros2dds on an ANVIL robot host — the OpenArm v2 workcell, whose
/// stack runs in the vendor's own compose project beside this bridge.
///
/// This is the robot profile with the commands taken out. The desktop drives an
/// Anvil through `fm/robot/<ns>/*` queryables served by fm-robot-agent, which
/// calls the vendor's own services on the host; nothing off-host publishes to
/// this workcell. So the bridge carries state outward and accepts nothing
/// inward, and the only motion command that exists is one the agent makes
/// locally.
///
/// This file is a TEMPLATE. `scripts/install-bridge.sh` renders it and writes the
/// result to /etc/fm-comms/bridge.json5. Committed files carry placeholders only —
/// never a real address. Read the render before installing it:
///
///     ./run.sh render bridge
///
/// Placeholders:
///   FM_ROUTER_ENDPOINT    the router, e.g. tcp/<workstation>:7447. Fleet-wide,
///                         from /etc/fm-comms.env.
///   FM_RIG_NAMESPACE      this rig's ROS namespace. Derived from the machine
///                         identity card's name and typed nowhere: fm-rob-01
///                         becomes fm_rob_01, because a ROS name may not carry
///                         a hyphen.
///   FM_ROS_DOMAIN_ID      the DDS domain the rig's nodes run on. Fleet-wide,
///                         from /etc/fm-comms.env.
{
  mode: "client",
  connect: {
    endpoints: ["${FM_ROUTER_ENDPOINT}"],
  },
  scouting: {
    multicast: { enabled: false },
  },

  plugins: {
    ros2dds: {
      namespace: "/${FM_RIG_NAMESPACE}",
      nodename: "zenoh_bridge_${FM_RIG_NAMESPACE}",
      domain: ${FM_ROS_DOMAIN_ID},

      /// Allowlist, and ONLY an allowlist. zenoh-plugin-ros2dds flattens allow
      /// and deny into a single untagged choice, so a config carrying both is
      /// refused at startup as "unknown field `deny`" — which reads as a typo
      /// and is not one.
      ///
      /// The rule that matters most on this host is enforced by absence, the
      /// same way bridge-robot.json5 keeps `joint_trajectory` off its arm: there
      /// is no `subscribers` list at all, so no key on the fabric can reach a
      /// DDS writer here. `/commanded_ee_left` and the forward position
      /// controllers move the arms with no limit checking of their own, and
      /// scripts/ci/check-transport.py tests both names against these patterns
      /// on every pull request.
      allow: {
        publishers: [
          /// Where the arms are — the stream the desktop renders.
          "^/joint_states$",
          /// Whether the hardware is active, paused, or faulted, which is what
          /// `stop` is confirmed against.
          "^/hardware_state_controller/state$",
          /// Whether a take is recording, and who holds the controls, so two
          /// operators cannot fight over one workcell.
          "^/recording_status$",
          "^/controls_owner$",
          /// End effector poses, left and right.
          "^/ee_pose_.*$",
          /// Wrist and scene cameras, compressed only. A raw frame is 20-50x
          /// the bytes and nothing on the fabric reads one.
          "^/cam_.*/compressed$",
        ],
      },

      /// The desktop renders well below what the workcell produces: the arms
      /// publish joint states far faster than a cockpit draws, and a camera at
      /// its native rate is the largest thing this host could put on the wire.
      pub_max_frequencies: [
        "/joint_states=50",
        "/ee_pose_.*=30",
        "/cam_.*/compressed=10",
      ],

      reliable_routes_blocking: false,
    },
  },
}
