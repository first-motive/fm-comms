/// zenoh-bridge-ros2dds on a ROBOT rig — an arm under ros2_control with MoveIt
/// Servo, driven from the desktop teleop surface.
///
/// This is the one bridge that carries COMMANDS to actuators, so its inbound
/// allowlist is deliberately short and explicit. A topic that moves a physical
/// arm is added here on purpose, never by a wildcard.
///
/// This file is a TEMPLATE. `scripts/install-bridge.sh` renders it and writes the
/// result to /etc/fm-comms/bridge.json5. Committed files carry placeholders only —
/// never a real address. Read the render before installing it:
///
///     ./run.sh render bridge
///
/// Placeholders:
///   FM_ROUTER_ENDPOINT    the router, e.g. tcp/<workstation>:7447. Fleet-wide,
///                         from /etc/fm-comms.env.
///   FM_RIG_NAMESPACE      this rig's ROS namespace. Derived from the machine
///                         identity card's name and typed nowhere: fm-rec-01
///                         becomes fm_rec_01, because a ROS name may not carry
///                         a hyphen.
///   FM_ROS_DOMAIN_ID      the DDS domain the rig's nodes run on. Fleet-wide,
///                         from /etc/fm-comms.env.
{
  mode: "client",
  connect: {
    endpoints: ["${FM_ROUTER_ENDPOINT}"],
  },
  scouting: {
    multicast: { enabled: false },
  },

  plugins: {
    ros2dds: {
      namespace: "/${FM_RIG_NAMESPACE}",
      nodename: "zenoh_bridge_${FM_RIG_NAMESPACE}",
      domain: ${FM_ROS_DOMAIN_ID},

      /// Allowlist, and ONLY an allowlist. zenoh-plugin-ros2dds flattens allow
      /// and deny into a single untagged choice, so a config carrying both is
      /// refused at startup as "unknown field `deny`" — which reads as a typo
      /// and is not one.
      ///
      /// So the rule that matters most on this rig is enforced by absence: no
      /// inbound pattern below matches `<controller>/joint_trajectory`. The arm
      /// controllers take that topic directly, bypassing Servo's limits and
      /// collision checking, and a remote publisher on a lossy link must never
      /// reach them. Every pattern is anchored so none can widen into it by
      /// accident, and scripts/ci/check-transport.py compiles these patterns and
      /// tests them against a real trajectory topic name on every pull request.
      allow: {
        publishers: [
          /// State the cockpit renders: where the arm is, what it looks like.
          "^/joint_states$",
          "^/robot_description$",
          "^/tf$",
          "^/tf_static$",
          "^/rosout$",
          /// Servo's own status, so the operator sees why a jog was refused.
          "^/servo_node.*/status$",
        ],
        subscribers: [
          /// Jog commands. Servo applies its own limits and collision checks on
          /// the rig, so a dropped or delayed sample degrades to "stop", not to
          /// an unbounded motion.
          "^/servo_node.*/delta_twist_cmds$",
          "^/servo_node.*/delta_joint_cmds$",
          "^/target_pose$",
          /// Gripper open/close presets.
          "^/gripper_teleop/.*/preset$",
          /// Base velocity, on the robots that have a base.
          "^/cmd_vel$",
        ],
        service_servers: [
          /// Switching controllers is how teleop is armed and disarmed.
          "^/controller_manager/.*$",
          "^/robot_state_publisher/.*$",
          "^/servo_node.*/.*$",
        ],
      },

      /// TF at full rate is the largest stream a robot rig produces; the cockpit
      /// renders well below it.
      pub_max_frequencies: [
        "/tf=30",
        "/joint_states=50",
      ],

      reliable_routes_blocking: false,
    },
  },
}
